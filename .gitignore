# Allowlist: data pipeline, model code, analysis scripts, figures and reports are tracked; data is not.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/understat_MANIFEST.sha256
!/pipeline/
!/model_v1/
/model_v1/*
!/model_v1/pi_rating_model.py
!/model_v1/01_build_dataset.py
!/analysis/
!/figures/
!/docs/

# inside the allowed folders, still exclude local-only work and caches
/pipeline/04_*.py
/docs/ARCHIVE_LOG.md
/docs/KNOWN_ISSUES.md
__pycache__/
*.pyc
.DS_Store
/docs/PI_RATINGS_QC_*.md
